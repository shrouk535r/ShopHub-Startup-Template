@model myshop.MVC.ViewModels.HomeVM

@{
    Layout = "~/Views/Shared/_Customer.cshtml";
}

    <style>
        /* Theme: remap Bootstrap's own CSS variables so every btn/badge/link/border
               component picks up the brand palette automatically - no component overrides needed. */
        

        .bg-cream {
            background-color: var(--bs-primary-second);
        }

        
        .hero-bg {
            background: #ddd6c9 url('https://images.unsplash.com/photo-1445205170230-053b83016050?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat;
            min-height: 420px;
        }

        /* Product/category hover overlay - no Bootstrap utility covers hover-reveal, kept minimal */
        .img-overlay {
            background: rgba(21,42,86,.55);
            opacity: 0;
            transition: opacity .2s ease;
        }

        .hover-target:hover .img-overlay {
            opacity: 1;
        }

        .price-old {
            text-decoration: line-through;
        }

        
        
        @@media (max-width: 991.98px) {
            .hero-card {
                margin-top: 1rem;
                margin-bottom: 1rem;
            }
        }
    </style>
    <!-- ============ HERO ============ -->
    <section class="container mt-4">
        <div class="hero-bg rounded-4 d-flex align-items-center overflow-hidden">
            <div class="bg-cream rounded-3 p-4 p-md-5 ms-auto hero-card" style="width:min(460px, 92%);">
                <div class="text-danger fw-bold small text-uppercase" style="letter-spacing:2px;">New Arrival</div>
                <h1 class="fw-bold my-3" style="font-size:2.1rem; line-height:1.2; color: var(--bs-primary)">Discover Our<br> New Collection</h1>
                <p class="text-body-muted">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis.</p>
                <button style="background-color: var(--bs-primary2)" class="btn btn-primary px-4 py-2 fw-semibold">BUY NOW</button>
            </div>
        </div>
    </section>

    <!-- ============ CATEGORIES ============ -->
    <section class="container mt-5" id="categories">
        <h2 class="text-center fw-bold mb-4">Categories</h2>
        <div class="row g-3" id="categoriesGrid">
        @{
            foreach(var item in Model.Categories)
            {
                <div class="col-md-4">
                    <div class="position-relative rounded-3 overflow-hidden ratio ratio-4x3 hover-target">
                        <img src="@item.Image" class="object-fit-cover" alt="@item.Name">
                        <div class="position-absolute bottom-0 start-0 w-100 text-center text-white fw-bold py-2"
                             style="background: linear-gradient(transparent, rgba(0,0,0,0.5)); text-shadow: 1px 1px 3px rgba(0,0,0,0.8);">
                            @item.Name
                        </div>
                    </div>
                </div>
            }
        }
        </div>
    </section>

    <!-- ============ PRODUCTS ============ -->
    <section class="container mt-5" id="products">
        <h2 class="text-center fw-bold mb-4">Our Products</h2>
        <div class="row g-3" id="productsGrid">
        @{
            foreach(var item in Model.Products)
            {
                <div class="col-md-4">
                    <div class="card h-100 border shadow-sm">
                        <div class="position-relative ratio ratio-1x1 hover-target">
                            <img src= "@item.Img" class="object-fit-contain" alt="@item.Name">
                            
                            <div class="img-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                                <button style="background-color:var(--bs-primary-second); color:var(--bs-primary); border-radius:10px" class="btn btn-light btn-sm fw-semibold add-to-cart-btn">Add to cart</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <h6 class="card-title fw-bold mb-0 small">@item.Name</h6>
                            <span class="badge rounded-pill text-bg-info">@item.CategoryName</span>

                            <p class="card-text text-body-muted small mb-2">@string.Join(" ", (item.Description.Split(" ").Take(7)))</p>
                            <p class="fw-bold text-primary mb-0 small">
                                @item.Price &nbsp;$
                            </p>
                        </div>
                    </div>
                </div>
            }
        }
        </div>

        <div class="text-center my-5">
            <button  class="primary-btn btn btn-outline-primary px-5">Show More</button>
        </div>
    </section>

