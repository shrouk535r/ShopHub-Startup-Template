@model IEnumerable<myshop.BLL.DTO.UserDto>

<div class="container mt-4">
    <h2>User Management</h2>
    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        @if (user.IsLocked)
                        {
                            <span class="badge bg-danger">Locked</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        <form asp-action="SwitchRole" asp-route-id="@user.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-warning">Change Role</button>
                        </form>

                        <form asp-action="ToggleLock" asp-route-id="@user.Id" method="post" class="d-inline">
                            @if (user.IsLocked)
                            {
                                <button type="submit" class="btn btn-sm btn-success">Unlock</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-secondary">Lock</button>
                            }
                        </form>

                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>