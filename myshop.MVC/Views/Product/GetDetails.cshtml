@model myshop.BLL.DTO.ProductDetailsDto

@{
    ViewData["Title"] = "GetDetails";
    ViewBag.CardTitle = "Product Details";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<style>
    /* Card Container: Soft, shadow-matched to your page */
    .product-card-large {
        background: linear-gradient(180deg,#ffffff 0%,#f8fbff 100%);
        border: 1px solid #d9e4f5;
        border-radius: 32px;
        box-shadow: 0 15px 40px rgba(13,110,253,.10), 0 5px 15px rgba(0,47,122,.06);
        overflow: visible !important;
    }

    .product-image-wrapper {
        position: relative;
        overflow: visible;
    }


    .product-card-img-large {
        width: 100%;
        height: 350px;
        object-fit: cover;
        border-radius: 24px;
    }


    /* Floating preview */
    .product-preview {
        position: absolute;
        left: 50%;
        top: 50%;
        /* width: 500px; */
        /* height: 500px; */
        transform: translate(-50%, -50%) scale(.8);
        background: white;
        border-radius: 25px;
        box-shadow: 0 25px 60px rgba(0,0,0,.35);
        opacity: 0;
        visibility: hidden;
        transition: .35s ease;
        z-index: 9999;
    }


    .product-image-wrapper:hover .product-preview {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, -50%) scale(1);
    }


    .product-preview img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 25px;
    }
    /* Price Badge: Using your Hero Blue for high-impact contrast */
    .product-price-badge {
        background: linear-gradient( 135deg, #ffcc4d, #ff9f1c );
        color: white;
        font-weight: 700;
        padding: 0.6rem 1.4rem;
        border-radius: 20px;
    }

    /* Category Badge: Using your light background tones (#eef2f7) */
    .product-category-badge {
        background-color: #eef2f7;
        color: #002f7a; /* Deep blue text for legibility */
        border: 1px solid #c3dafe;
        padding: 0.5rem 1.2rem;
        border-radius: 14px;
        font-weight: 600;
    }

    /* Buttons Container */
    .product-actions {
        display: flex;
        gap: 16px;
        margin-top: 30px;
    }

    /* Back Button */
    .product-back-btn {
        flex: 1;
        background: rgba(255,255,255,.7);
        border: 2px solid #d9e4f5;
        color: #004bba;
        border-radius: 18px;
        padding: 0.9rem;
        font-weight: 600;
        transition: .3s ease;
        backdrop-filter: blur(8px);
    }

        .product-back-btn:hover {
            background: #eef5ff;
            border-color: #0d6efd;
            color: #002f7a;
            transform: translateY(-3px);
        }

    /* Edit Button */
    .product-edit-btn {
        flex: 1;
        background: linear-gradient(135deg,#00c6ff,#0d6efd,#004bba);
        border: none;
        color: white;
        border-radius: 18px;
        padding: .9rem;
        font-weight: 700;
        transition: .35s;
        box-shadow: 0 10px 25px rgba(13,110,253,.25);
    }

        .product-edit-btn:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 35px rgba(13,110,253,.35);
        }

    /* Icons */
    .product-actions i {
        font-size: 1rem;
    }
    </style>
@functions{
    public string makeStarRate(decimal rate)
    {
        int fullStars = (int)Math.Floor(rate);
        bool hasHalfStar = (rate - fullStars) >= 0.5m;
        string starsHtml = string.Empty;

        for (int i = 1; i <= 5; i++)
        {
            if (i <= fullStars)
            {
                starsHtml += "<i class=\"fa-solid fa-star\"></i>";
            }
            else if (i == fullStars + 1 && hasHalfStar)
            {
                starsHtml += "<i class=\"fa-solid fa-star-half-stroke\"></i>";
            }
            else
            {
                starsHtml += "<i class=\"fa-regular fa-star\"></i>";
            }
        }

        return starsHtml;
    }
  }
<!-- Centered Flex Container -->
<div class="container d-flex justify-content-center align-items-center py-5">

    <!-- Large Card Container (Max width caps it so the image doesn't distort on huge monitors) -->
    <div class="card product-card-large w-100" style="max-width: 650px;">

        <!-- Large Product Image -->
        <div class="product-image-wrapper">
            <img id="ImagePreview" src="~/@Model.Img"
             class="card-img-top product-card-img-large" alt="@Model.Name">

            <div class="product-preview">
                <img id="ImagePreview"  src="~/@Model.Img" alt="@Model.Name">
            </div>
        </div>

        @* <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80"
             class="card-img-top product-card-img-large" alt="Product Name"> *@

        <div class="card-body px-3 pb-2 pt-4">
            <!-- Title and Price Row -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class=" fw-bold mb-0 display-6">
                    @Model.Name
                </h2>
                <span class="product-price-badge">
                    @Model.Price $
                </span>
            </div>
            <div class="d-flex align-items-center gap-2  mb-4" style="font-size:18px;">
                

                <div class="text-warning" >
                    @Html.Raw(makeStarRate(Model.ReviewRating))
                </div>
                &ensp;
                <div class="fw-bold">
                    @Model.ReviewRating.ToString("0.0")
                </div>
                &ensp;

                <div class="text-muted">
                    (@Model.ReviewsCount reviews)
                </div>
            </div>
            <!-- Category -->
            <div class="mb-4">
                <span class="product-category-badge">
                    @Model.CategoryName
                </span>
            </div>

            <!-- Full Description (Removed line-clamp so the user can read the whole thing) -->
            <p class="card-text text-muted mb-5" style="font-size: 1.05rem; line-height: 1.6;">
                @Model.Description
            </p>

            <div class="product-actions">

                <a asp-action="Index" class="btn product-back-btn">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back to List
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn product-edit-btn">
                    <i class="fas fa-pen me-2"></i>
                    Edit Product
                </a>

            </div>
        </div>
        <div class="border-top my-4 py-3 ml-4">
            <div class="d-flex align-items-center justify-content-between mb-4 ">
            <h4 class="fw-bold mb-0">
                 Customer Reviews (@Model.ReviewsCount)
                
                
            </h4>
                <button type="button"
                        class="btn p-0 mr-3"
                        data-toggle="collapse"
                        data-target="#reviewsSection"
                        aria-expanded="true"
                        aria-controls="reviewsSection">
                    <i class="fa-solid fa-caret-down me-2"></i>
                </button>
            </div>
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                
                    @foreach (var review in Model.Reviews)
                    {
                        var customerName = review.UserName ?? "Anonymous";
                        var initials = customerName.Length >= 2
                        ? customerName.Substring(0, 2).ToUpper()
                        : customerName.ToUpper();

                    <div class="review-item border-bottom pb-3 mb-3 collapse hide" id="reviewsSection">

                            <div class="d-flex align-items-start gap-3">

                                <!-- Customer Initials -->
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                     style="width:45px;
                                        height:45px;
                                        min-width:45px;
                                        background-color:#e8f1ff;
                                        color:#0056d6;">
                                    @initials
                                </div>

                                <!-- Review Content -->
                                <div class="flex-grow-1">

                                    <!-- Customer Name -->
                                    <div class="fw-bold mb-1">
                                        @customerName
                                    </div>

                                    <!-- Stars -->
                                    <div class="text-warning mb-2" style="font-size:18px;">
                                    @Html.Raw(makeStarRate(review.Value))
                                        <span class="text-dark ms-2 fw-semibold">
                                            @review.Value.ToString("0.0")
                                        </span>
                                    </div>

                                    <!-- Review Text -->
                                    <p class="text-muted mb-0">
                                        @review.Description
                                    </p>

                                </div>

                            </div>

                        </div>
                    }

            }
            else
            {
                <div id="reviewsSection" class="collapse hide">
                    <p class="text-muted text-center mb-0">
                        No reviews yet.
                    </p>
                </div>

            }
        </div>

        </div>
    </div>
</div>
