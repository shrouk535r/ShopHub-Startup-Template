@using Microsoft.AspNetCore.Identity
@using myshop.BLL.DTO;
@using myshop.BLL.ExtensionMethods;
@inject SignInManager<myshop.Entities.Models.ApplicationUser> SignInManager
@inject UserManager<myshop.Entities.Models.ApplicationUser> UserManager
@inject IHttpContextAccessor httpContextAccessor

@{
    var appUser = await UserManager.GetUserAsync(User);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MyShop</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <style>
        /* Theme: remap Bootstrap's own CSS variables so every btn/badge/link/border
                       component picks up the brand palette automatically - no component overrides needed. */
        :root {
            --bs-primary: #002F7A;
            --bs-primary2: #1e3c72;
            --bs-primary-hover: #002255;
            --bs-primary-rgb: 21, 42, 86;
            --bs-primary-second: #f7f1e6;
            --bs-danger: #e8455b;
            --bs-danger-rgb: 232, 69, 91;
            --bs-success: #2fb6a5;
            --bs-success-rgb: 47, 182, 165;
            --bs-link-color: var(--bs-primary);
            --bs-link-hover-color: #0e1d3d;
            --bs-body-font-family: 'Poppins', sans-serif;
            --bs-border-radius: .5rem;
            --bs-border-radius-lg: .75rem;
        }

        #toast-container.toast-top-right {
            top: 100px !important;
            right: 12px !important;
            .text-body-muted {
            color: #7a7f8b;
        }

        .cart-scroll {
            max-height: 320px;
            overflow-y: auto;
        }

        .primary-btn {
            color: var(--bs-primary);
            border-color: var(--bs-primary);
        }

        .primary-btn:hover {
                background-color: #0040a8;
            color: white;
        }

        .primary-btn-fill{
            background-color:var(--bs-primary);
            color:white;
        }
        .primary-btn-fill:hover{
            background-color: var(--bs-primary-hover);
                color: white;
        }
    </style>
</head>
<body>

    <!-- ============ NAVBAR ============ -->
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top py-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="#">
                <img src="~/Images/logos/Logo01.png" style="width:50px; height:50px;" alt="Logo Img" /> MyShop
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-lg-auto mb-3 mb-lg-0 gap-lg-2">
                    <li class="nav-item"><a class="nav-link fw-medium" href="#">Home</a></li>
                    <li class="nav-item"><a class="nav-link fw-medium" href="#categories">Categories</a></li>
                    <li class="nav-item"><a class="nav-link fw-medium" href="#products">Products</a></li>
                    <li class="nav-item"><a class="nav-link fw-medium" href="#">Contact</a></li>
                </ul>

                @{
                    if (SignInManager.IsSignedIn(User))
                    {
                        if (User.IsInRole("Customer"))
                        {
                            <!-- Signed-in state -->
                            <div class="d-flex align-items-center gap-2 gap-lg-3" id="signedInBlock">

                                <!-- Account dropdown (Bootstrap dropdown auto-closes on outside click) -->
                                <div class="dropdown">
                                    <button class="btn btn-light d-flex align-items-center gap-2 fw-semibold" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle fs-5"></i>
                                        <span id="navUserName">@appUser.FName</span>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end shadow p-3" style="min-width:250px;">
                                        <div class="d-flex align-items-center gap-3 mb-2">
                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                            style="width:44px;height:44px;" id="avatarInitial">
                                                @appUser.FName.ToUpper()[0]
                                            </div>
                                            <div class="text-truncate">
                                                <p class="fw-bold mb-0 small" id="panelUserName">@appUser.FullName</p>
                                                <p class="text-body-muted mb-0 small text-truncate" id="panelUserEmail">@appUser.Email</p>
                                            </div>
                                        </div>
                                        <hr class="my-2" />
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="btn btn-outline-danger btn-sm w-100" id="logoutBtn" type="submit">
                                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                                        </button>
                                        </form>
                                    </div>
                                </div>

                                <!-- Cart dropdown -->
                                @{
                                    var cart = httpContextAccessor.HttpContext?.Session.Get<ShoppingCartDto>(appUser.Id);
                                    var count = cart?.Count ?? 0;
                                }
                                      
                                <div class="dropdown">
                                    <a href="@Url.Action("GetCart", "ShoppingCart", new { returnUrl = Context.Request.Path})"
                                       class="btn btn-light position-relative" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-cart3 fs-5"></i>
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cartBadge">@count</span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end shadow p-0" style="width:340px;max-width:88vw;">
                                        <h6 class="dropdown-header fw-bold text-dark border-bottom py-3 px-3 mb-0">Your Cart</h6>
                                        @{
                                            if(cart == null)
                                            {
                                                TempData["ErrorMessage"] = "Cart Not Created";

                                            }
                                            else if(!cart.CartItems.Any())
                                            {
                                                 <div class="text-center text-body-muted py-4">
                                                    <i class="bi bi-cart-x fs-2"></i>
                                                    <p class="mt-2 mb-0 small">Your cart is empty</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="px-3 cart-scroll" id="cartItemsWrap">
                                                @foreach(var item in cart.CartItems){
                                                <div class="d-flex align-items-center gap-2 py-2 border-bottom cart-item" data-id="@item.Id">
                                                    <img src=~/@item.productImg class="rounded object-fit-cover flex-shrink-0" style="width:50px;height:50px;" alt="@item.ProductName">
                                                    <div class="flex-grow-1" style="min-width:0;">
                                                        <p class="small fw-semibold mb-1 text-truncate">@item.ProductName</p>
                                                        <p class="small text-primary fw-bold mb-1">@item.ProductPrice EGP</p>
                                                        <div class="btn-group btn-group-sm" role="group">
                                                            <a href="@Url.Action("DecreaseQty", "ShoppingCart", new { returnUrl = Context.Request.Path, cartItemId=item.Id })" 
                                                            class="btn btn-outline-secondary qty-minus" type="button">&minus;</a>
                                                            <button class="btn btn-outline-secondary disabled" tabindex="-1">@item.Quantity</button>
                                                            <a href="@Url.Action("IncreaseQty", "ShoppingCart", new { returnUrl = Context.Request.Path, cartItemId = item.Id })"
                                                         
                                                            class="btn btn-outline-secondary qty-plus" type="button">+</a>
                                                        </div>
                                                    </div>
                                                     <a href="@Url.Action("DeleteItem", "ShoppingCart", new { returnUrl = Context.Request.Path, cartItemId = item.Id })"
                                                    class="btn btn-sm btn-outline-danger ci-delete flex-shrink-0" type="button">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                                }
                                                </div>
                                                <div class="border-top p-3">
                                                    <div class="d-flex justify-content-between fw-bold mb-3">
                                                        <span>Total</span>
                                                        <span id="cartTotal">@cart.TotalPrice EGP</span>
                                                    </div>
                                                    <button style="background-color:var(--bs-primary)" class="btn btn-primary w-100 mb-2" id="checkoutBtn" type="button">Checkout</button>
                                                    <a href="@Url.Action("ClearCart", "ShoppingCart", new { returnUrl = Context.Request.Path })" class="btn btn-outline-danger w-100" id="clearCartBtn" type="button">Clear Cart</a>
                                                </div>
                                                
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                else
                {
                    <!-- Signed-out state -->
                    <div class="d-flex gap-3" id="signedOutBlock">
                            <a asp-action="Login" asp-controller="Account" class="btn primary-btn" id="signInBtn" type="button">Sign In</a>
                            <a asp-action="Register" asp-controller="Account"  class="btn primary-btn-fill" id="signUpBtn" type="button">Sign Up</a>
                    </div>
                }
                }
            </div>
        </div>
    </nav>
<main>

        <partial name="_Toaster" />

@RenderBody()

</main>

    <!-- ============ FOOTER ============ -->
    <footer class="border-top pt-5 pb-4 mt-4">
        <div class="container">
            <div class="row gy-4">
                <div class="col-6 col-md-3">
                    <div class="fw-bold text-primary fs-5">MyShop</div>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="text-body-muted fw-semibold">Links</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a class="link-body-emphasis" href="#">Home</a></li>
                        <li class="mb-2"><a class="link-body-emphasis" href="#categories">Categories</a></li>
                        <li class="mb-2"><a class="link-body-emphasis" href="#products">Products</a></li>
                        <li class="mb-2"><a class="link-body-emphasis" href="#">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="text-body-muted fw-semibold">Help</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a class="link-body-emphasis" href="#">Payment Options</a></li>
                        <li class="mb-2"><a class="link-body-emphasis" href="#">Returns</a></li>
                        <li class="mb-2"><a class="link-body-emphasis" href="#">Privacy Policies</a></li>
                    </ul>
                </div>
                <div class="col-12 col-md-3">
                    <h6 class="text-body-muted fw-semibold">Newsletter</h6>
                    <div class="input-group input-group-sm border-bottom pb-1">
                        <input type="email" class="form-control border-0 px-0" placeholder="Enter Your Email Address" />
                        <button class="btn btn-link text-decoration-none fw-bold p-0 ps-2" type="button">SUBSCRIBE</button>
                    </div>
                </div>
            </div>
            <div class="border-top mt-5 pt-3 text-body-muted small">2024 MyShop. All rights reserved</div>
        </div>
    </footer>
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/adminlte.min.js"></script>

    <script src="//cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function(){
            const mainNavEl = document.getElementById("mainNav");
            const bsCollapse = bootstrap.Collapse.getOrCreateInstance(mainNavEl, { toggle: false });
            mainNavEl.querySelectorAll(".nav-link").forEach(link => {
                link.addEventListener("click", () => bsCollapse.hide());
            });

        })();
    </script>
</body>
</html>
