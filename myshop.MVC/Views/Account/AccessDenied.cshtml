@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow p-4 border-danger">
                <h1 class="text-danger display-4">403</h1>
                <h2 class="text-dark">Access Denied</h2>
                <p class="text-muted mt-3">
                    Sorry, you do not have permission to access this page. Please contact the administrator if you believe this is an error.
                </p>
                <div class="mt-4">
                    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>